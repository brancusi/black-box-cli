{:paths ["src" "skills"]
 ;; bbin install . --as blackbox puts this checkout on your PATH (on a Mac without Black Box's bundled copy).
 :bbin/bin {blackbox {:main-opts ["-m" "black-box-cli.main"]}}
 :tasks {dist {:doc "The release files in target/: blackbox-cli.jar (src and skills/ inside; `bb blackbox-cli.jar` runs it), its .sha256, and blackbox-cli.json, the manifest Black Box updates from. bb dist vX.Y.Z also checks the tag against the version."
               :extra-paths ["dev"]
               :requires ([release])
               :task (release/dist! (first *command-line-args*))}
         release-key {:doc "Makes this Mac's release signing key once (Ed25519, in the keychain) and writes its public half to docs/release-key.pub; says which it has after."
                      :extra-paths ["dev"]
                      :requires ([release])
                      :task (release/release-key!)}
         release {:doc "A release in one step: bb release X.Y.Z [summary] [--trailer \"Key: value\"]… [--dry-run]. Dates the CHANGELOG's Unreleased, sets the version, runs the checks, commits, tags, builds (jar, .sha256, manifest), signs the manifest with this Mac's release key, pushes and publishes on GitHub, then checks the download as Black Box will. Nothing waits on GitHub's own run."
                  :extra-paths ["dev"]
                  :requires ([release])
                  :task (release/release! *command-line-args*)}
         test {:doc "Runs every test against the fixture media_meta in test/fixtures. Never reads real media."
               :extra-paths ["test"]
               :requires ([black-box-cli.test-runner :as runner])
               :task (runner/run *command-line-args*)}
         golden {:doc "Runs test/golden/steps.json and says which steps already print what the old CLI printed."
                 :extra-paths ["test"]
                 :requires ([black-box-cli.golden :as golden])
                 :task (golden/report! *command-line-args*)}
         review-dev {:doc "This checkout's review server on this Mac's own reviews, beside the installed one: bb review-dev [review-id] [--port 7388]. Opens the review (the newest by default); the page reloads with edits, a .clj edit restarts it. Pages say DEV."
                     :extra-paths ["dev"]
                     :requires ([review-dev])
                     :task (review-dev/run *command-line-args*)}
         nrepl {:doc "The REPL, with dev/ and test/ on the classpath: bb nrepl [port]. Writes .nrepl-port. Calva's jack-in runs it."
                :extra-paths ["dev" "test"]
                :requires ([babashka.fs :as fs]
                           [babashka.nrepl.server :as nrepl])
                :task (let [port (or (some-> (first *command-line-args*) parse-long) 0)
                            ;; Prints "Started nREPL server at 127.0.0.1:<port>", which is what Calva waits for.
                            server (nrepl/start-server! {:host "127.0.0.1" :port port})]
                        (require (symbol "user") :reload)
                        (spit ".nrepl-port" (:port server))
                        (.addShutdownHook (Runtime/getRuntime) (Thread. (fn [] (fs/delete-if-exists ".nrepl-port"))))
                        (deref (promise)))}
         editors {:doc "Writes docs/EDITORS.md from the tutorial's lessons (src/black_box_cli/tutorial.clj)."
                  :requires ([black-box-cli.tutorial :as tutorial])
                  :task (spit "docs/EDITORS.md" (tutorial/markdown))}
         narrate {:doc "Makes the animated tutorial's narration with ElevenLabs (the `elevenlabs` CLI): only lines without audio. bb narrate --dry-run lists them."
                  :extra-paths ["dev"]
                  :requires ([narrate])
                  :task (narrate/narrate! :dry-run (some #{"--dry-run"} *command-line-args*))}
         lint {:doc "clj-kondo over src, test and dev."
               :task (shell "clj-kondo --lint src test dev")}
         fmt {:doc "cljfmt check (fmt fix to rewrite)."
              :task (shell (str "cljfmt " (or (first *command-line-args*) "check") " src test dev bb.edn"))}}}
