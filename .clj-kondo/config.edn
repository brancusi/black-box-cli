{:linters {;; Only `out` prints (AGENTS.md, Layout). Everything else returns data.
           :discouraged-var {clojure.core/println {:message "Print through black-box-cli.out, not println."}
                             clojure.core/prn {:message "Print through black-box-cli.out, not prn."}}}
 :config-in-ns {black-box-cli.out {:linters {:discouraged-var {:level :off}}}
                black-box-cli.main {:linters {:discouraged-var {:level :off}}}
                black-box-cli.golden {:linters {:discouraged-var {:level :off}}}
                dev {:linters {:discouraged-var {:level :off}}}
                fiddle {:linters {:discouraged-var {:level :off}}}}}
